{
  "name": "corip",
  "version": "1.0.0",
  "description": "API server for tour, leisure, and shared-taxi participant postings",
  "main": "src/index.js",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:local": "node scripts/dev.js",
    "dev:server": "PORT=3001 node src/index.js",
    "dev:web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "start": "node src/index.js",
    "test": "node --test src/*.test.js",
    "test:all": "npm test && npm run build:web"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10"
  }
}
