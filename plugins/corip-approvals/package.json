{
  "name": "corip-approvals",
  "version": "0.2.0",
  "type": "module",
  "description": "Native OpenClaw approval card for Corip travel-email synchronization",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build",
    "plugin:validate": "npm run build && npm test",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "dependencies": {
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "openclaw": "2026.7.1-2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    }
  }
}
